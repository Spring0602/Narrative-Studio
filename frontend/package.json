    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@vitejs/plugin-vue": "5.2.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vue-tsc": "2.1.10"
  }
}
